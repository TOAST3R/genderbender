name: LIQUID DNB
# Rhodes con 7as y 9as, sub largo y ligado, arpegios en la melodia. Acordes de 2 compases
# (a 174 BPM). Pad como en gb_18 (BASE p4/5 en el centro).
bpm: 174
meter: 4/4
key: F
scale: major
chord_bars: 2
cycle: 8
form.bass: A A A A'
form.chord: A A A A
form.mel: A A' A B

prog: ii7 V9 Imaj7 Imaj7
prog: vi7 ii7 V9 Imaj7
prog: Imaj7 iii7 vi7 IVmaj7
prog: IVmaj7 iii7 ii7 Imaj7
sub: V9 > bII7
sub: ii7 > IVmaj7
sub: Imaj7 > vi7
markov: ii7 > V9 3, IVmaj7 1
markov: V9 > Imaj7 3, vi7 1
markov: Imaj7 > vi7 2, IVmaj7 2, ii7 1
markov: vi7 > ii7 3, IVmaj7 1
markov: IVmaj7 > iii7 1, V9 1, ii7 1
markov: iii7 > vi7 1, ii7 1

[p0 p1]                               # INTRO: solo pads largos
bass.rhy   .... .... .... ....
chord.rhy  X... .... .... ....
chord.voi  9... .... .... ....
chord.art  ~... .... .... ....
mel.rhy    .... .... .... ....
[p1]
bass.rhy   X... .... .... ....
bass.art   ~... .... .... ....

[p2 p3]                               # ENERGIA: sub con rebote, arpegio en semicorcheas
bass.rhy   X... .... ..X. X...
bass.deg   R... .... ..5. R...
bass.art   ~... .... ..~. ~...
chord.rhy  X... .... X... ....
chord.voi  9... .... 7... ....
chord.art  ~... .... ~... ....
mel.rhy    X.XX X.XX X.XX X.XX
mel.cnt    ^.^^ ^.-- ^.^^ -.--

[p4 p5]                               # BASE
bass.rhy   X... .... .... ..X.
bass.deg   R... .... .... ..5.
bass.art   ~... .... .... ..~.
chord.rhy  X... .... .... ....
chord.voi  9... .... .... ....
chord.art  ~... .... .... ....
mel.rhy    X.X. X.X. X.X. X.x.
mel.cnt    ^.^. ^.^. -.-. -.+.
[p5]
bass.rhy   X... .... .... ....
bass.deg   R... .... .... ....
bass.art   ~... .... .... ....
mel.cnt    ^.^. ^.-. ^.-. -.-.

[p6 p7]                               # VARIACION: bajo en octavas, acorde que respira
bass.rhy   X... ..X. .... X...
bass.deg   R... ..8. .... 5...
bass.art   ~... ..~. .... ~...
chord.rhy  X... .... ..X. ....
chord.voi  7... .... ..9. ....
chord.art  ~... .... ..~. ....
mel.rhy    X... ..X. X... ..X.
mel.cnt    ^... ..^. -... ..-.

[p8]                                  # FILL: aproximacion al siguiente acorde
bass.rhy   X... .... X.X. X.X.
bass.deg   R... .... 5.3. 7.a.
bass.art   ~... .... .... ....
chord.rhy  X... .... .... ....
chord.voi  9... .... .... ....
chord.art  ~... .... .... ....
mel.rhy    XXXX XXXX XXXX XXXX
mel.cnt    ^^^^ ^^^^ ---- ----
