desc: GenderBender test logger
//tags: MIDI test
// Banco de pruebas (tools/reaper_test): deja pasar el MIDI y anota cada evento en gmem "gbtestlog".
// Cada logger tiene su zona (base = id * 200000), porque las pistas se procesan en hilos distintos y un contador
// compartido pierde eventos. gmem[base] = numero de eventos; el evento i ocupa gmem[base + 1 + i*5 .. base + 5 + i*5]:
//   beat (beat_position + desplazamiento en el bloque), estado, dato 1, dato 2, midi_bus + 100 * id.
// Anota tambien con el transporte parado (los NoteOff que el plugin manda al parar). Lua vacia con gmem[base] = 0.
options:gmem=gbtestlog

slider1:0<0,9,1>logger id

in_pin:none
out_pin:none

@init
ext_midi_bus = 1;
ZONE = 200000;
MAXE = (ZONE - 1) / 5 - 1;

@block
bpb = tempo / (60 * srate);
while (midirecv(ofs, m1, m2, m3)) (
  base = slider1 * ZONE;
  n = gmem[base];
  n < MAXE ? (
    gmem[base + 1 + n*5] = beat_position + ofs * bpb;
    gmem[base + 2 + n*5] = m1; gmem[base + 3 + n*5] = m2; gmem[base + 4 + n*5] = m3;
    gmem[base + 5 + n*5] = midi_bus + 100 * slider1;
    gmem[base] = n + 1;
  );
  midisend(ofs, m1, m2, m3);
);
