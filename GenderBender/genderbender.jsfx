@init
/// EXTRACT STYLES DATA FROM THE TEXT FILE
old_slider1=slider1;
old_slider2=slider2;
old_slider3=slider3;
old_slider4=slider4;
old_slider5=slider5;
old_slider6=slider6;
old_slider7=slider7;
str = #myString;
substr = #mySubString;
temp=#tempchar;
kicks=#kicks;
kickArray0=#kick0;
kickArray1=#kick1;
