// ---------- BOTONES RANDOM STYLE ----------
function drawButton(x, y, w, h, label) local(hover, sw, sh)(
	hover = mx >= x && mx < x+w && my >= y && my < y+h;
	hover ? (gfx_r=0.30; gfx_g=0.30; gfx_b=0.30) : (gfx_r=0.14; gfx_g=0.14; gfx_b=0.14);
	gfx_a = 0.95;
	gfx_rect(x, y, w, h);
	gfx_r=0.5; gfx_g=0.5; gfx_b=0.5; gfx_a=1;           // borde
	gfx_rect(x, y, w, 1);   gfx_rect(x, y+h-1, w, 1);
	gfx_rect(x, y, 1, h);   gfx_rect(x+w-1, y, 1, h);
	gfx_r=0.92; gfx_g=0.92; gfx_b=0.92;
	gfx_measurestr(label, sw, sh);
	gfx_x = x + (w-sw)/2; gfx_y = y + (h-sh)/2;
	gfx_drawstr(label);
	hover && (mouse_cap & 1) && !(lastCap & 1);          // 1 solo en el flanco de pulsacion
);

gfx_setfont(4, "Arial", 11, 'b');
btnAll  = drawButton(16, 326, 76, 22, "ALL RND");    // un mismo estilo para las 7 voces
btnEach = drawButton(98, 326, 76, 22, "EACH RND");   // un estilo distinto por voz
gfx_setfont(1);

// Un cambio de slider hecho desde codigo NO ejecuta @slider, asi que cargamos los patrones aqui
function reloadAllStyles()(
	loadStyle(1); old_slider1 = slider1;
	loadStyle(2); old_slider2 = slider2;
	loadStyle(3); old_slider3 = slider3;
	loadStyle(4); old_slider4 = slider4;
	loadStyle(5); old_slider5 = slider5;
	loadStyle(6); old_slider6 = slider6;
	loadStyle(7); old_slider7 = slider7;
);

btnAll ? (
	bR = STYLE_FIRST + floor(rand(numStyles - STYLE_FIRST));
	bI = 1;
	loop(7, slider(bI) = bR; bI += 1;);
	reloadAllStyles();
	sliderchange(127);      // bits 0..6 = sliders 1..7 (actualiza la interfaz)
	slider_automate(127);
);

btnEach ? (
	bI = 1;
	loop(7, slider(bI) = STYLE_FIRST + floor(rand(numStyles - STYLE_FIRST)); bI += 1;);
	reloadAllStyles();
	sliderchange(127);
	slider_automate(127);
);

lastCap = mouse_cap;

// ---- volcar el buffer a la ventana, reescalado y centrado ----
gfx_dest = -1;
gfx_set(0.07,0.07,0.07,1);
gfx_rect(0,0,gfx_w,gfx_h);
gfx_set(1,1,1,1);
gfx_blit(UI_BUF, 1, 0, 0, 0, UI_W, UI_H, uiOffX, uiOffY, UI_W*uiScale, UI_H*uiScale);
