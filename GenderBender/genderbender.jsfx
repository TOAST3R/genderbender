	sector == 1 ? Tdrum1 = ( ( (hitom[hitomPosition+(32*(0 + secondBar)) ] * Xmap) + (hitom[hitomPosition+(32*( 2  + secondBar )) ] * (1 - Xmap) ) ) * Ymap ) + ( ( (hitom[hitomPosition+(32*( 4  + secondBar ))] * Xmap) + (hitom[hitomPosition+(32*( 6  + secondBar ))] * (1 - Xmap) ) ) * ( 1 - Ymap) );
