	sector == 4 ? Tdrum2 = ( ( (lotom[lotomPosition+(32*(0 + secondBar)) ] * ( 1 - Xmap ) ) + (lotom[lotomPosition+(32*( 8 ))] * Xmap ) ) * Ymap ) + ( ( (lotom[lotomPosition+(32*( 4  + secondBar ))] * ( 1 - Xmap ) ) + (lotom[lotomPosition+(32*( 2  + secondBar ))] * Xmap ) ) * ( 1 - Ymap) );
