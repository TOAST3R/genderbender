function changeBar()( 

	secondBar > 0 ? secondBar=100 : secondBar=0;

);

// ---------- RANDOM STYLES ----------
// cuenta cuantos archivos hay en la lista de estilos: recorre los valores del slider8
// (archivo, sin uso) hasta que no haya nombre o se repita (por si REAPER limita el valor)
function countStyles() local(i, n, ok, h, keep)(
	keep = slider8;
	i=0; n=0; ok=1;
	#prev = "";
	while (ok && i < 512) (
		slider8 = i;
		strcpy_fromslider(#probe, slider8);
		strlen(#probe) > 0 && strcmp(#probe, #prev) != 0 && (h = file_open(#probe)) >= 0 ? (
			file_close(h);
			strcpy(#prev, #probe);
			n += 1;
			i += 1;
		) : ok = 0;
	);
	slider8 = keep;
	n;
);

STYLE_FIRST = 0;          // primer indice valido (sube a 1 si el 0 no es un estilo real)
numStyles = countStyles();
numStyles < 1 ? numStyles = 24;
lastCap = 0;

// evalua el paso pos de la voz v (0..6): morph XY + densidad (o break). Devuelve 1 si suena.
function voiceHit(v, pos, brk) local(val, dens)(
	v==0 ? (kickPosition=pos;     kdrumFunc();   val=Kdrum;  dens=kick_Dens.val_pos);
	v==1 ? (snarePosition=pos;    sdrumFunc();   val=Sdrum;  dens=snare_Dens.val_pos);
	v==2 ? (clapPosition=pos;     cdrumFunc();   val=Cdrum;  dens=clap_Dens.val_pos);
	v==3 ? (hhclosedPosition=pos; hhcdrumFunc(); val=H1drum; dens=hhclosed_Dens.val_pos);
	v==4 ? (hhopenPosition=pos;   hhodrumFunc(); val=H2drum; dens=hhopen_Dens.val_pos);
	v==5 ? (hitomPosition=pos;    htdrumFunc();  val=Tdrum1; dens=hitom_Dens.val_pos);
	v==6 ? (lotomPosition=pos;    ltdrumFunc();  val=Tdrum2; dens=lotom_Dens.val_pos);
	brk ? (256-val) < (dens/2 - rand(breakAmountRandom.val_pos)) : (256-val) < dens;
);

// programa los pasos de la voz v en la rejilla divs[idx] cuyo tiempo recto cae en (h0, h1]
// brk=1 rejilla de break, brk=0 rejilla normal (en la ventana de break la normal no suena)
function scheduleGrid(v, idx, brk, h0, h1) local(div, k, kEnd, t, inBrk, sv, tt)(
	div = divs[floor(idx)];
	k = floor(h0*div) + 1;
	kEnd = floor(h1*div);
	while (k <= kEnd) (
		t = k / div;
		inBrk = slider(11+5*v) > 0 && inBreakWindow(t) ? 1 : 0;
		abs(t - skipAt[v]) < 0.000001 ? (
			inBrk = -1;  // ya sono adelantado antes del salto (slide negativo en un loop)
			skipAt[v] = -1;
		);
		t >= 0 && inBrk == brk ? (
			secondBar = (floor(t) % 8) >= 4;
			voiceHit(v, k % 32, brk) ? (
				sv = 50 + (slider52 - 50) * slider(53+v) / 100;
				tt = swingWarp(t, sv) + slider(60+v) / 1000 * tempo / 60;
				qPush(1, tt, (slider46+(7*slider47))+v, slider(12+5*v), slider(13+5*v) / (ts_num*16), t, v);
			);
		);
		k += 1;
	);
);


