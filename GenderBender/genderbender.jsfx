	sector == 4 ? H1drum = ( ( (hhclosed[hhclosedPosition+(32*(0 + secondBar)) ] * ( 1 - Xmap ) ) + (hhclosed[hhclosedPosition+(32*( 8 ))] * Xmap ) ) * Ymap ) + ( ( (hhclosed[hhclosedPosition+(32*( 4  + secondBar ))] * ( 1 - Xmap ) ) + (hhclosed[hhclosedPosition+(32*( 2  + secondBar ))] * Xmap ) ) * ( 1 - Ymap) );
