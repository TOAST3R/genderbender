// COLA DE EVENTOS (fuera de la zona de patrones 100..2187, que antes pisaba la cola vieja en 2100)
QSIZE=128;
evType=20000;   // 0 = libre, 1 = NoteOn pendiente, 2 = NoteOff pendiente
evTime=20200;   // tiempo programado en negras (beat_position)
evNote=20400;
evVel=20600;
evDur=20800;    // duracion en negras (solo NoteOn)
evStraight=21000; // tiempo recto (sin swing/slide) del paso
evVoice=21200;
anticipT=21400; // por voz: tiempo recto del ultimo NoteOn emitido
skipAt=21410;   // por voz: paso a omitir tras un salto (ya sono adelantado)
memset(evType, 0, QSIZE);
memset(anticipT, -1000000, 7);
memset(skipAt, -1, 7);
SLIDE_MAX_MS=30;
evalHorizon=0;  // hasta que tiempo (negras) se han evaluado los pasos
expectedB0=0;   // beat_position esperado al inicio del siguiente bloque
wasPlaying=0;
secondBar=0;

