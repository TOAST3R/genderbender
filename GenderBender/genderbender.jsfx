// ---------- COLA DE EVENTOS MIDI ----------
// encola un evento; devuelve 0 si la cola esta llena (el NoteOn se descarta)
function qPush(type, t, note, vel, dur, ts, v) local(i, done)(
	i=0; done=0;
	while (i < QSIZE && !done) (
		evType[i]==0 ? (
			evType[i]=type; evTime[i]=t; evNote[i]=note; evVel[i]=vel; evDur[i]=dur;
			evStraight[i]=ts; evVoice[i]=v;
			done=1;
		);
		i+=1;
	);
	done;
);

// offset de sample dentro del bloque actual para el tiempo t (negras)
function sampleOffset(t)(
	min(max(floor((t - b0) / bpb), 0), samplesblock-1);
);

// envia y libera los NoteOff pendientes de la nota noteFilter (<0 = todas)
function flushNoteOffs(offset, noteFilter) local(i)(
	i=0;
	loop(QSIZE,
		evType[i]==2 && (noteFilter < 0 || evNote[i]==noteFilter) ? (
			midisend(offset, $x80, evNote[i], 0);
			evType[i]=0;
		);
		i+=1;
	);
);

// salto de transporte / stop: suelta las notas que suenan y descarta los NoteOn pendientes
function resetQueue()(
	flushNoteOffs(0, -1);
	memset(evType, 0, QSIZE);
);

// emite en orden temporal (NoteOff antes que NoteOn si empatan) los eventos con t < b1
// (el ultimo medio sample queda para el bloque siguiente: un paso justo en el final de un loop no suena)
function emitDue() local(i, best, bt, off, n)(
	while (
		best=-1; bt=b1 - 0.5*bpb;
		i=0;
		loop(QSIZE,
			evType[i] && (evTime[i] < bt || (best >= 0 && evTime[i]==bt && evType[i]==2 && evType[best]==1)) ? (
				best=i; bt=evTime[i];
			);
			i+=1;
		);
		best >= 0 ? (
			off = sampleOffset(evTime[best]);
			n = evNote[best];
			evType[best]==1 ? (
				evType[best]=0;
				flushNoteOffs(off, n);  // re-disparo: el NoteOff viejo no corta la nota nueva
				midisend(off, $x90, n, evVel[best]);
				anticipT[evVoice[best]] = evStraight[best];
				evType[best]=2;         // el mismo hueco pasa a ser su NoteOff
				evTime[best]+=evDur[best];
			) : (
				midisend(off, $x80, n, 0);
				evType[best]=0;
			);
		);
		best >= 0;
	);
);

// ---------- SWING ----------
// deformacion lineal a trozos de cada corchea: la 2a semicorchea pasa de 0.25 a s/100*0.5 negras
function swingWarp(t, s) local(cell, u, p)(
	cell = floor(t*2)/2;
	u = t - cell;
	p = s/100*0.5;
	cell + (u < 0.25 ? u*(p/0.25) : p + (u-0.25)*((0.5-p)/0.25));
);

function inBreakWindow(t) local(c)(
	c = t % (breakInterval.val_pos) + 1;
	c >= breakOffset.val_pos && c >= breakInterval.val_pos - (breakDur.val_pos-1);
);

function kdrumFunc()(
	//SECTOR 1 0,1,2 3

	sector == 1 ? Kdrum = ( ( (kick[kickPosition+(32*(0 + secondBar)) ] * Xmap) + (kick[kickPosition+(32*( 2  + secondBar )) ] * (1 - Xmap) ) ) * Ymap ) + ( ( (kick[kickPosition+(32*( 4  + secondBar ))] * Xmap) + (kick[kickPosition+(32*( 6  + secondBar ))] * (1 - Xmap) ) ) * ( 1 - Ymap) );
	sector == 2 ? Kdrum = ( ( (kick[kickPosition+(32*(0 + secondBar)) ] * Xmap) + (kick[kickPosition+(32*( 4  + secondBar ))] * (1 - Xmap) ) ) * ( Ymap ) ) + ( ( (kick[kickPosition+(32*( 6  + secondBar ))] * Xmap) + (kick[kickPosition+(32*( 8 ))] * (1 - Xmap) ) ) * (1 - Ymap) );
