	//SECTOR 1 0,1,2 3

	sector == 1 ? Tdrum2 = ( ( (lotom[lotomPosition+(32*(0 + secondBar)) ] * Xmap) + (lotom[lotomPosition+(32*( 2  + secondBar )) ] * (1 - Xmap) ) ) * Ymap ) + ( ( (lotom[lotomPosition+(32*( 4  + secondBar ))] * Xmap) + (lotom[lotomPosition+(32*( 6  + secondBar ))] * (1 - Xmap) ) ) * ( 1 - Ymap) );
	sector == 2 ? Tdrum2 = ( ( (lotom[lotomPosition+(32*(0 + secondBar)) ] * Xmap) + (lotom[lotomPosition+(32*( 4  + secondBar ))] * (1 - Xmap) ) ) * ( Ymap ) ) + ( ( (lotom[lotomPosition+(32*( 6  + secondBar ))] * Xmap) + (lotom[lotomPosition+(32*( 8 ))] * (1 - Xmap) ) ) * (1 - Ymap) );
