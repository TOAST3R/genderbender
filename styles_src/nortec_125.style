name: NORTEC 125
# Nortec (Tijuana, 2000s): norteño y tambora sobre techno. Tempo sugerido: 125 BPM. Div por defecto (4).
# Fuente del ritmo: Wikipedia ("Nortec"): tarola, rimshots y redobles polirritmicos de la tambora sobre un 4/4 de club.
# Voces: kick=bombo  snare=tarola norteña  hhc=hat cerrado  hitom/lotom=toms
# Groove: swing 50 · slide: 0
# Pad: centro=BASE p4/5 · derecha=ENERGIA p2/3 · arriba-dcha=VARIACION p6/7
#      izquierda/abajo=INTRO p0/1 · abajo-dcha/arriba-centro=FILL p8
# Escala: X=255 x=204 o=153 -=102 ,=51 .=0
# Density (por defecto 50) solo deja sonar X; x entra con >52, o con >103, - con >154, , con >205.

[p0 p1]                         # INTRO: hats y percusion
hhc    XXXX XXXX XXXX XXXX
[p1]
kick   X... .... .... ....
snare  .... .... .... X...

[p2 p3]                         # ENERGIA: hats completos y adornos
kick   X... X... X... X..o
snare  ..X. ..Xo ..X. ..X.
hhc    XXXX XXXX XXXX XXXX
hitom  .... .... ...- ....
[p3]
snare  ....X... ....X.o. ....X... xox-Xox-

[p4 p5]                         # BASE
kick   X... X... X... X...
snare  ..X. ..X. ..X. ..X.
hhc    XXXX XXXX XXXX XXXX

[p6 p7]                         # VARIACION: menos hats, toms
kick   X... X... X... X...
snare  ..X. ..X. ..X. ..X.
hhc    X.X. X.X. X.X. X.X.
hitom  ...X .... ...X ....
lotom  .... ..X. .... ..x.

# p8 (FILL) vacio: repetiria el de otro estilo
