name: PEAK TIME TECHNO 132
# Peak time / driving techno (2010s). Tempo sugerido: 132 BPM. Div por defecto (4).
# Voces: kick=bombo  snare=caja o rim  clap=palmas  hhc=hat cerrado  hho=hat abierto  hitom/lotom=toms
# Groove: swing 50 · slide: 0
# Pad: centro=BASE p4/5 · derecha=ENERGIA p2/3 · arriba-dcha=VARIACION p6/7
#      izquierda/abajo=INTRO p0/1 · abajo-dcha/arriba-centro=FILL p8
# Escala: X=255 x=204 o=153 -=102 ,=51 .=0
# Density (por defecto 50) solo deja sonar X; x entra con >52, o con >103, - con >154, , con >205.

[p0 p1]                         # INTRO: hats y percusion
hhc    ..XX ..XX ..XX ..XX
hho    ..X. ..X. ..X. ..X.
[p1]
kick   X... .... .... ....
clap   .... .... .... X...

[p2 p3]                         # ENERGIA: hats completos y adornos
kick   X... X... X... X..o
clap   .... X..o .... X...
hhc    xxXX xxXX xxXX xxXX
hho    ..X. ..X. ..X. ..X.
hitom  .... .... ...- ....
[p3]
clap   ........ X.....o. ........ Xox-xox-

[p4 p5]                         # BASE
kick   X... X... X... X...
clap   .... X... .... X...
hhc    ..XX ..XX ..XX ..XX
hho    ..X. ..X. ..X. ..X.

[p6 p7]                         # VARIACION: los toms toman el ritmo de los hats
kick   X... X... X... X...
clap   .... X... .... X...
hhc    x... x... x... x...
hitom  ..XX ..XX .... ....
lotom  .... .... ..XX ..XX
[p7]
kick   X... X... X... X..x
clap   .... X... .... X.X.

[p8]                            # FILL: redoble que acentua los golpes de la base
kick   X... X... .... ....
clap   ........ X....... X.x.x.x. Xoxoxoxo
hitom  .... .... ..XX ....
lotom  .... .... .... ..XX
