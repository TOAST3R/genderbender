name: PHONK 130
# Phonk de Memphis: medio tiempo y cencerro en lugar de hi-hat. Tempo sugerido: 130 BPM. Div por defecto (4).
# Fuente del ritmo: guias de phonk (Melodics, Native Instruments, Violet Recording): el cencerro sustituye al hi-hat; 130-135 BPM.
# Voces: kick=808  snare=caja  clap=palmas  hitom=cencerro (la nota la decide el sampler)
# Groove: swing 50 · slide: 0
# Pad: centro=BASE p4/5 · derecha=ENERGIA p2/3 · arriba-dcha=VARIACION p6/7
#      izquierda/abajo=INTRO p0/1 · abajo-dcha/arriba-centro=FILL p8
# Escala: X=255 x=204 o=153 -=102 ,=51 .=0
# Density (por defecto 50) solo deja sonar X; x entra con >52, o con >103, - con >154, , con >205.

[p0 p1]                         # INTRO: hats y percusion
hhc    ..X. ..X. ..X. ..X.
hitom  X.X. .XX. X.X. .X.X
[p1]
kick   X... .... .... ....
snare  .... .... .... X...

[p2 p3]                         # ENERGIA: hats completos y adornos
kick   X... ...X .... ...o
snare  .... ...o X... ....
clap   .... .... X... ...X
hhc    ..x. ..x. ..x. ..x.
hitom  X.X. .XX. X.X- .X.X
[p3]
snare  ........ ......o. X....... xox-xox-

[p4 p5]                         # BASE
kick   X... ...X .... ....
snare  .... .... X... ....
clap   .... .... X... ...X
hitom  X.X. .XX. X.X. .X.X

[p6 p7]                         # VARIACION: menos hats, toms
kick   X... ...X .... ....
snare  .... .... X... ....
clap   .... .... X... ...X
hhc    X... X... X... X...
hitom  X.X. .XX. X.X. .X.X
lotom  .... ..X. .... ..x.
[p7]
snare  .... .... X... ..X.

[p8]                            # FILL
kick   X... .... .... ....
snare  ........ X....... X...X... XoXoXoXo
hitom  .... .... .X.X ....
lotom  .... .... .... X.X.
