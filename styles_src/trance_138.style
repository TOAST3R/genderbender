name: TRANCE 138
# Trance (bombo a negras, hat abierto a contratiempo y redobles de subida). Tempo sugerido: 138 BPM. Div por defecto (4).
# Voces: kick=bombo  snare=redobles  clap=palmas  hhc=hat cerrado  hho=hat abierto
# Groove: swing 50 (recto) · slide: 0
# Subida con Density: en p2/p3 y p8 el snare va en corcheas (X), semicorcheas (x) y fusas (o).
#   Al subir Density, el redoble se acelera.
# Pad: centro=BASE p4/5 · derecha=ENERGIA p2/3 · arriba-dcha=VARIACION p6/7
#      izquierda/abajo=INTRO p0/1 · abajo-dcha/arriba-centro=FILL p8
# Escala: X=255 x=204 o=153 -=102 ,=51 .=0
# Density (por defecto 50) solo deja sonar X; x entra con >52, o con >103, - con >154, , con >205.

[p0 p1]                         # INTRO: hats
hho    ..X. ..X. ..X. ..X.
hhc    .x.x .x.x .x.x .x.x
[p1]
kick   X... .... .... ....

[p2 p3]                         # ENERGIA: subida en dos compases
kick   X... X... X... X...
clap   .... X... .... X...
hhc    .x.x .x.x .x.x .x.x
hho    ..X. ..X. ..X. ..X.
snare  X.x.X.x. X.x.X.x. X.x.X.x. X.x.X.x.
[p3]
snare  XoxoXoxo XoxoXoxo XoxoXoxo XoxoXoxo

[p4 p5]                         # BASE
kick   X... X... X... X...
clap   .... X... .... X...
hhc    .x.x .x.x .x.x .x.x
hho    ..X. ..X. ..X. ..X.
[p5]
snare  .... .... .... -.-.

[p6 p7]                         # VARIACION: hats cerrados al frente
kick   X... X... X... X...
clap   .... X... .... X...
hhc    .X.X .X.X .X.X .X.X
hho    ..X. ..X. ..X. ..X.
[p7]
snare  .... .... .... X.X.

[p8]                            # FILL: redoble de subida
kick   X... .... .... ....
snare  XoxoXoxo XoxoXoxo XoxoXoxo XoxoXoxo
clap   .... .... .... X...
