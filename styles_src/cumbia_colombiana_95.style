name: CUMBIA COLOMBIANA 95
# Cumbia tradicional colombiana. Tempo sugerido: 95 BPM. Div por defecto (4).
# Voces: kick=tambora (golpe)  snare=llamador  clap=palmas  hhc=guache/guacharaca
#        hho=maracas  hitom=tambor alegre (improvisa)  lotom=tambora (aro)
# Groove: swing 52 · amount: hhc 100, kick 0 · slide: —
# Pad: centro=BASE p4/5 · derecha=ENERGIA p2/3 · arriba-dcha=VARIACION p6/7
#      izquierda/abajo=INTRO p0/1 · abajo-dcha/arriba-centro=FILL p8
# Escala: X=255 x=170 o=120 -=60 .=0
# Density (por defecto 50) solo deja sonar X; x entra con Density>=87, o con >=137, - con >=197.
# Regla: lo esencial del ritmo va en X; los adornos en x/o/- para que Density los vaya sumando. (los valores bajos caen antes al bajar Density)

[p0 p1]                         # INTRO: guache y tambora suelta
hhc    X.XX X.XX X.XX X.XX
kick   X... .... .... ....
[p1]
kick   X... .... X... ....
hho    -.o. -.o. -.o. -.o.

[p2 p3]                         # ENERGIA: guache a semicorcheas, palmas, alegre activo
kick   X... ..o. X... ..o.
snare  ..X. .-X. ..X. .-X.
clap   .... X... .... X...
hhc    XXXX XXXX XXXX XXXX
hho    -.o. -.o. -.o. -.o.
hitom  o.Xo .oX. o.Xo X.xX
[p3]
lotom  .... .... .... ..xX

[p4 p5]                         # BASE
kick   X... .... X... ....
snare  ..X. ..X. ..X. ..X.
hhc    X.XX X.XX X.XX X.XX
hho    -.o. -.o. -.o. -.o.
hitom  -..o ..-. .o.. -.o.
lotom  .... .... .... ..x.
[p5]
kick   X... ...o X... ....
hitom  .o.. o..- ..o. o.x.

[p6 p7]                         # VARIACION: tambor alegre al frente
kick   X... .... .... ....
snare  ..X. ..X. ..X. ..X.
hhc    X.XX X.XX X.XX X.XX
hitom  X.o. x.oX .o.x X.x.
lotom  ..o. .... ..o. ....
[p7]
hitom  x.xX .o.x X.o. xxX.

[p8]                            # FILL: redoble de alegre y tambora
kick   X... .... .... ....
snare  ..X. .... .... ....
hhc    X.XX X.XX .... ....
hitom  X.x. x.xx X.xx XxXx
lotom  ...o ..o. ..o. o.oX
