name: CUMBIA VILLERA 98
# Cumbia villera (Argentina). Tempo sugerido: 98 BPM. Div por defecto (4).
# Voces: kick=bombo  snare=timbal (aro)  clap=clap  hhc=guira  hho=hat abierto
#        hitom=timbal alto  lotom=timbal bajo
# Groove: swing 56 · slide: clap -5 ms (empuja)
# Pad: centro=BASE p4/5 · derecha=ENERGIA p2/3 · arriba-dcha=VARIACION p6/7
#      izquierda/abajo=INTRO p0/1 · abajo-dcha/arriba-centro=FILL p8
# Escala: X=255 x=204 o=153 -=102 ,=51 .=0 · valores antiguos congelados como [170]/[120]/[60]
# Density (por defecto 50) solo deja sonar X; x entra con Density>=87, o con >=137, - con >=197.
# Regla: lo esencial del ritmo va en X; los adornos en x/o/- para que Density los vaya sumando.

[p0 p1]                         # INTRO: guira
hhc    XX[170]X XX[170]X XX[170]X XX[170]X
[p1]
clap   .... X... .... X...

[p2 p3]                         # ENERGIA
kick   X..[120] X... X..[120] X...
snare  ..X. .[170]X. ..X. .[170]X.
clap   .... X... .... X...
hhc    XXXX XXXX XXXX XXXX
hho    ..[170]. ..[170]. ..[170]. ..[170].
hitom  .... .... .... .[120][170]X
[p3]
hitom  .... .... ..[120]. [170][120][170]X
lotom  .... .... .... [120].[120].

[p4 p5]                         # BASE
kick   X... .... X... ....
snare  ..X. ..X. ..X. ..X.
clap   .... X... .... X...
hhc    XX[170]X XX[170]X XX[170]X XX[170]X
hitom  .... .... .... .[120][170]X
[p5]
hitom  .... .... ..[120]. [170][120][170]X
lotom  .... .... .... [120].[120].

[p6 p7]                         # VARIACION: timbales al frente
kick   X... .... X... ....
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
hitom  [170].[120][170] .[170].[120] [170].[120][170] .[170][120][170]
lotom  ..[120]. [120]... ..[120]. [120].[120].
[p7]
hitom  [170].[120][170] .[170].[120] [170][170][120][170] X[170]X[170]

[p8]                            # FILL
kick   X... .... .... ....
clap   .... X... .... X...
hitom  [170].[170]. [170][170][170]. [170][120][170][120] X[170]X[170]
lotom  .[120].[120] ...[120] .[170].[170] .[170]XX
