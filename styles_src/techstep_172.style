name: TECHSTEP 172
# Techstep (two-step frio y escaso). Tempo sugerido: 172 BPM. Div por defecto (4).
# Voces: kick=bombo  snare=caja  clap=rim  hhc=hat cerrado  hho=ride
#        hitom/lotom=casi vacios (golpes metalicos sueltos)
# Groove: swing 50 (recto) · slide: —
# Pad: centro=BASE p4/5 · derecha=ENERGIA p2/3 · arriba-dcha=VARIACION p6/7
#      izquierda/abajo=INTRO p0/1 · abajo-dcha/arriba-centro=FILL p8
# Escala: X=255 x=204 o=153 -=102 ,=51 .=0
# Density (por defecto 50) solo deja sonar X; x entra con >52, o con >103, - con >154, , con >205.

[p0 p1]                         # INTRO: hat en negras y rim
hhc    X... X... X... X...
[p1]
clap   .... .... .... ...X

[p2 p3]                         # ENERGIA
kick   X... ...o ..X. ..x.
snare  .... X... .... X..-
clap   .... .... .... ...X
hhc    X.x. X.x. X.x. X.x.
hho    ..o. ..o. ..o. ..o.
lotom  .... .... .... .,..
[p3]
kick   X... ...o ..X. x.x.

[p4 p5]                         # BASE
kick   X... ...- ..X. ....
snare  .... X... .... X...
clap   .... .... .... ...X
hhc    X.,. X.,. X.,. X.,.
lotom  .... .... .... .-..
[p5]
kick   X... ...- ..X. .,o.
hitom  .... .... ..-. ....

[p6 p7]                         # VARIACION: ride en lugar del hat
kick   X... .... ..X. ....
snare  .... X... .... X...
hho    X.X. X.X. X.X. X.X.
hitom  .... ..o. .... ...x
[p7]
clap   .... .... .... .x.X

[p8]                            # FILL
kick   X... .... .... ....
snare  .... X... X.X. XXXX
lotom  .... .... .x.x .x..
