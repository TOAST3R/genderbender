name: NITZHONOT 150
# Nitzhonot (goa israeli de los 90, melodico y euforico). Tempo sugerido: 150 BPM. Div por defecto (4).
# Fuente del ritmo: Wikipedia ("Nitzhonot"): rama rapida y melodica del goa israeli, bombo 4/4 contundente.
# Voces: kick=bombo  snare=caja o rim  clap=palmas  hhc=hat cerrado  hho=hat abierto  hitom/lotom=toms
# Groove: swing 50 · slide: 0
# Pad: centro=BASE p4/5 · derecha=ENERGIA p2/3 · arriba-dcha=VARIACION p6/7
#      izquierda/abajo=INTRO p0/1 · abajo-dcha/arriba-centro=FILL p8
# Escala: X=255 x=204 o=153 -=102 ,=51 .=0
# Density (por defecto 50) solo deja sonar X; x entra con >52, o con >103, - con >154, , con >205.

[p0 p1]                         # INTRO: hats y percusion
hhc    X.X. X.X. X.X. X.X.
hho    ..X. ..X. ..X. ..X.
[p1]
kick   X... .... .... ....
snare  .... .... .... X...

[p2 p3]                         # ENERGIA: hats completos y adornos
kick   X... X... X... X..o
snare  .... X..o .... X...
clap   .... X... .... X...
hhc    XxXx XxXx XxXx XxXx
hho    ..X. ..X. ..X. ..X.
hitom  .... .... ...- ....
[p3]
snare  ........ X.....o. ........ Xox-xox-

[p4 p5]                         # BASE
kick   X... X... X... X...
snare  .... X... .... X...
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
hho    ..X. ..X. ..X. ..X.

[p6 p7]                         # VARIACION: menos hats, toms
kick   X... X... X... X...
snare  .... X... .... X...
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
hho    ..X. ..X. ..X. ..X.
hitom  ...X .... ...X ....
lotom  .... ..X. .... ..x.
[p7]
snare  .... X... .... X.X.

[p8]                            # FILL
kick   X... .... .... ....
snare  ........ X....... X...X... XoXoXoXo
hitom  .... .... .X.X ....
lotom  .... .... .... X.X.
