name: ROCKSTEADY 80
# Rocksteady (Jamaica, 1966-68): mas lento que el ska, bombo en el 3. Tempo sugerido: 80 BPM. Div por defecto (4).
# Voces: kick=bombo  clap=cross-stick  hhc=hat cerrado  hho=hat abierto
# Groove: swing 58 · amount: hhc 100, hho 100, resto 0 · slide: 0
# Pad: centro=BASE p4/5 · derecha=ENERGIA p2/3 · arriba-dcha=VARIACION p6/7
#      izquierda/abajo=INTRO p0/1 · abajo-dcha/arriba-centro=FILL p8
# Escala: X=255 x=204 o=153 -=102 ,=51 .=0
# Density (por defecto 50) solo deja sonar X; x entra con >52, o con >103, - con >154, , con >205.

[p0 p1]                         # INTRO: hats y percusion
hhc    X.X. X.X. X.X. X.X.
hho    .... ..X. .... ..X.
[p1]
kick   X... .... .... ....
clap   .... .... .... X...

[p2 p3]                         # ENERGIA: hats completos y adornos
kick   .... .... X... ...o
clap   .... X..o .... X...
hhc    XxXx XxXx XxXx XxXx
hho    .... ..X. .... ..X.
hitom  .... .... ...- ....
[p3]
clap   ........ X.....o. ........ Xox-xox-

[p4 p5]                         # BASE
kick   .... .... X... ....
clap   .... X... .... X...
hhc    X.X. X.X. X.X. X.X.
hho    .... ..X. .... ..X.

[p6 p7]                         # VARIACION: los toms toman el ritmo de los hats
kick   .... .... X... ....
clap   .... X... .... X...
hhc    x... x... x... x...
hitom  X.X. X.X. .... ....
lotom  .... .... X.X. X.X.
[p7]
kick   .... .... X... ...x
clap   .... X... .... X.X.

[p8]                            # FILL: redoble que acentua los golpes de la base
clap   ........ X....... X.x.x.x. Xoxoxoxo
hitom  .... .... X.X. ....
lotom  .... .... .... X.X.
