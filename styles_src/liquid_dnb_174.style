name: LIQUID DNB 174
# Liquid drum & bass: ride en corcheas y caja con fantasmas. Tempo sugerido: 174 BPM. Div por defecto (4).
# Voces: kick=bombo  snare=caja  hho=ride  hitom/lotom=toms
# Groove: swing 54 · amount: hho 100, resto 0 · slide: snare -2 ms · velocidad del snare baja: las fantasmas suenan igual de fuerte
# Pad: centro=BASE p4/5 · derecha=ENERGIA p2/3 · arriba-dcha=VARIACION p6/7
#      izquierda/abajo=INTRO p0/1 · abajo-dcha/arriba-centro=FILL p8
# Escala: X=255 x=204 o=153 -=102 ,=51 .=0
# Density (por defecto 50) solo deja sonar X; x entra con >52, o con >103, - con >154, , con >205.

[p0 p1]                         # INTRO: hats y percusion
hho    X.X. X.X. X.X. X.X.
[p1]
kick   X... .... .... ....
snare  .... .... .... X...

[p2 p3]                         # ENERGIA: hats completos y adornos
kick   X... .... ..X. ...o
snare  .... X..- .-., X...
hhc    ..x. ..x. ..x. ..x.
hho    X.X. X.X. X.X. X.X.
hitom  .... .... ...- ....
[p3]
snare  ........ X.....-. ..-...,. Xox-xox-

[p4 p5]                         # BASE
kick   X... .... ..X. ....
snare  .... X..- .-., X...
hho    X.X. X.X. X.X. X.X.

[p6 p7]                         # VARIACION: menos hats, toms
kick   X... .... ..X. ....
snare  .... X..- .-., X...
hho    ..X. ..X. ..X. ..X.
hitom  ...X .... ...X ....
lotom  .... ..X. .... ..x.
[p7]
snare  .... X..- .-., X.X.

[p8]                            # FILL
kick   X... .... .... ....
snare  ........ X....... X...X... XoXoXoXo
hitom  .... .... .X.X ....
lotom  .... .... .... X.X.
