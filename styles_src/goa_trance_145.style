name: GOA TRANCE 145
# Goa trance (Goa, principios de los 90). Tempo sugerido: 145 BPM. Div por defecto (4).
# Voces: kick=bombo  snare=caja  hhc=hat cerrado  hho=hat abierto  hitom/lotom=toms tribales
# Groove: swing 50 · slide: 0
# Pad: centro=BASE p4/5 · derecha=ENERGIA p2/3 · arriba-dcha=VARIACION p6/7
#      izquierda/abajo=INTRO p0/1 · abajo-dcha/arriba-centro=FILL p8
# Escala: X=255 x=204 o=153 -=102 ,=51 .=0
# Density (por defecto 50) solo deja sonar X; x entra con >52, o con >103, - con >154, , con >205.

[p0 p1]                         # INTRO: hats y percusion
hhc    XXXX XXXX XXXX XXXX
hho    ..X. ..X. ..X. ..X.
hitom  ...x ..x. ...x .x..
[p1]
kick   X... .... .... ....
snare  .... .... .... X...

[p2 p3]                         # ENERGIA: hats completos y adornos
kick   X... X... X... X..o
snare  ..X. ...o ..X. ....
hhc    XXXX XXXX XXXX XXXX
hho    ..X. ..X. ..X. ..X.
hitom  ...x ..x. ...x .x..
[p3]
snare  ....X... ......o. ....X... XoX-XoX-

[p4 p5]                         # BASE
kick   X... X... X... X...
snare  ..X. .... ..X. ....
hhc    XXXX XXXX XXXX XXXX
hho    ..X. ..X. ..X. ..X.
hitom  ...x ..x. ...x .x..
[p5]
snare  ..X. .... ..X. XXXX

[p6 p7]                         # VARIACION: menos hats, toms
kick   X... X... X... X...
snare  ..X. .... ..X. ....
hhc    X.X. X.X. X.X. X.X.
hho    ..X. ..X. ..X. ..X.
hitom  ...x ..x. ...x .x..
lotom  .... ..X. .... ..x.
[p7]
snare  ..X. .... ..X. ..X.

# p8 (FILL) vacio: repetiria el de otro estilo
